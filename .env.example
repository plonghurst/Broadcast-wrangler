# Google Sheet ID for the distribution list
SHEET_ID="your-google-sheet-id"

# Email address used to send the broadcast
SENDER_EMAIL="moderator@telfordward.org"

# Gmail App Password for SENDER_EMAIL
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Optional: Only needed if you log into Gmail with a different primary address
# and send from SENDER_EMAIL as a "Send mail as" alias.
# GMAIL_USER="moderator@telfordward.org"
